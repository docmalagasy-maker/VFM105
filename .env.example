# Base de données Postgres (Vercel Storage > Postgres/Neon, ou équivalent)
DATABASE_URL=

# Stockage sécurisé des pièces jointes (Vercel Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Passerelle SMS Android du responsable du projet (secret partage, l'appli
# Android l'utilise pour s'authentifier quand elle interroge le serveur)
SMS_GATEWAY_SECRET=

# Accès à l'interface d'administration (basique, à renforcer avant production)
ADMIN_USER=admin
ADMIN_PASSWORD=
