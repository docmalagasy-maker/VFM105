# Base de données Postgres (Coolify > Resources > PostgreSQL, URL interne)
DATABASE_URL=
# Mettre à true uniquement pour une base externe qui exige SSL
DATABASE_SSL=false

# Dossier des pièces jointes (en production : volume persistant Coolify)
UPLOAD_DIR=./data/uploads

# Passerelle SMS Android du responsable du projet (secret partage, l'appli
# Android l'utilise pour s'authentifier quand elle interroge le serveur)
SMS_GATEWAY_SECRET=

# Super-administrateur (accès à tous les districts), page /admin/connexion
ADMIN_USER=admin
ADMIN_PASSWORD=
# Clé de signature des sessions admin (64 caractères aléatoires, conseillé)
SESSION_SECRET=

# Envoi d'e-mails (validation des administrateurs de district) : boîte LWS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@0550.site
SMTP_PASSWORD=
SMTP_FROM=VFM <noreply@0550.site>
# Destinataire des demandes d'accès (par défaut doc.malagasy@gmail.com)
SUPER_ADMIN_EMAIL=
# Adresse publique du site, utilisée dans les liens des e-mails
SITE_URL=https://vfm.0550.site
